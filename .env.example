# ============================================================
# STARFIRE ONE AI OS — Environment Configuration
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=change-me-to-a-32-char-random-key
LOG_LEVEL=INFO
PORT=8000

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://starfire:password@localhost:5432/starfire_db
SYNC_DATABASE_URL=postgresql://starfire:password@localhost:5432/starfire_db
POSTGRES_PASSWORD=change_me

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...          # embeddings (Knowledge OS) + Whisper fallback
GROQ_API_KEY=gsk_...           # Whisper transcription (faster/cheaper)

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...
TELEGRAM_WEBHOOK_URL=https://your-domain.com

# OSIRIS trading bot
OSIRIS_BOT_TOKEN=...
OSIRIS_TELEGRAM_CHAT_ID=...

# LUMISNOVA market data bot
LUMISNOVA_BOT_TOKEN=...
LUMISNOVA_TELEGRAM_CHAT_ID=...

# ── Broker (Alpaca paper trading) ────────────────────────────
BROKER_API_KEY=...
BROKER_API_SECRET=...
BROKER_BASE_URL=https://paper-api.alpaca.markets
USE_MOCK_BROKER=false

# Risk limits
RISK_MAX_DAILY_LOSS_PCT=5.0
RISK_MAX_POSITION_SIZE_PCT=25.0
RISK_MAX_TRADES_PER_DAY=10

# ── SnapTrade (Chase / brokerage aggregation) ────────────────
SNAPTRADE_CLIENT_ID=...
SNAPTRADE_CONSUMER_KEY=...

# ── Google OAuth (Gmail + Drive + Calendar) ──────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# ── Financial Market Data (FMP) ──────────────────────────────
FMP_API_KEY=...

# ── Inter-service (Railway private network) ──────────────────
INTER_SERVICE_SECRET=change-me-inter-service-secret
LUMISCAPITAL_SERVICE_URL=http://lumisnovacapital-bot.railway.internal:8001
OSIRIS_SERVICE_URL=http://osiris.railway.internal:8002
