# ============================================================
# STARFIRE AI OS — Environment Configuration
# ============================================================

# Application
APP_ENV=production
APP_SECRET_KEY=change-me-to-a-random-secret-key
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://starfire:password@localhost:5432/starfire_db
SYNC_DATABASE_URL=postgresql://starfire:password@localhost:5432/starfire_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.railway.app/webhook/telegram

# OSIRIS (Broker)
BROKER_API_KEY=mock
BROKER_API_SECRET=mock
BROKER_BASE_URL=https://paper-api.alpaca.markets
USE_MOCK_BROKER=true

# Risk Limits
RISK_MAX_DAILY_LOSS_PCT=5.0
RISK_MAX_POSITION_SIZE_PCT=25.0
RISK_MAX_TRADES_PER_DAY=10

# Lumiscapital / FMP
FMP_API_KEY=your-fmp-api-key

# Google Drive (optional)
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_TOKEN_JSON=

# Railway injects PORT automatically
PORT=8000
